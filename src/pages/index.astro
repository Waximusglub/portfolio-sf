---
import Layout from "../layouts/Layout.astro";

import Home from "../components/Home.astro";
import StartScreen from "../components/StartScreen.astro";
---

<Layout>
	<StartScreen/>
	<Home/>
</Layout>


<script>
    import gsap from "gsap";

    const HasVisited = sessionStorage.getItem("HasVisited");
	const startHero = document.querySelector("#starthero");

    let tl = gsap.timeline();

    if (HasVisited === "true") {

        startHero?.classList.add("hidden")

        tl.to(".projects",{
            autoAlpha: 1,
            duration: 0.5,
            ease: "power3.in"

        })
        
    } else {
        
        tl.to(".hero",{
            autoAlpha: 0,
            delay: 1,
            duration: 0.5,
            ease: "power3.in"

        })
        tl.to(".projects",{
            autoAlpha: 1,
            duration: 0.5,
            delay: 0.5,
            ease: "power3.in"

        })

        sessionStorage.setItem("HasVisited", "true");
    }
</script>

