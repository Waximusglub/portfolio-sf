---
import { getCollection } from "astro:content";
import { Icon } from "astro-iconset/components";

const links = await getCollection("link");
---

<div
    class="projects grid grid-cols-3 md:grid-cols-6 grid-rows-7 items-center justify-center w-dvw h-dvh p-40 opacity-0"
>
    <div
        class="bg-primary-red col-span-3 row-span-3 h-full rounded-[50px_50px_50px_0]"
    >
    </div>
    <div
        class="bg-primary-black col-span-2 row-span-2 h-full rounded-[50px_50px_0_50px] flex items-center justify-center"
    >
        <h2
            class="text-primary-white font-cormorant font-light text-[4rem] md:text-[10rem] tracking-[-6.5%] leading-none col-span-2"
        >
            <span
                class="font-cormorant font-bold italic text-[5rem] md:text-[12rem] tracking-[-8%]"
                >M</span
            >e
        </h2>
    </div>
    <div class="bg-primary-red h-full rounded-[50px_50px_0_50px] row-span-2">
    </div>

    <div
        class="bg-primary-red h-full col-span-3 rounded-[50px_50px_0_50px] flex items-center justify-evenly"
    >
        {
            links.map((link) => (
                <a
                    href={link.data.url}
                    target={link.data.options.target}
                    download={link.data.options.download || undefined}
                    rel={
                        link.data.options.rel ??
                        (link.data.options.target === "_blank"
                            ? "noopener noreferrer"
                            : undefined)
                    }
                    class="rounded-full flex items-center justify-center"
                >
                    <Icon
                        name={link.data.icon}
                        class="text-5xl text-primary-white"
                    />
                </a>
            ))
        }
    </div>

    <div
        class="bg-primary-red h-full col-span-2 row-span-2 rounded-[50px_50px_50px_0] flex items-center justify-center"
    >
    </div>

    <div
        class="bg-primary-red h-full row-span-2 rounded-[50px_50px_50px_0] flex items-center justify-center"
    >
    </div>

    <div
        class="bg-primary-red h-full col-span-3 row-span-4 rounded-[50px_50px_0_50px]"
    >
    </div>

    <div
        class="bg-primary-black h-full col-span-3 row-span-2 rounded-t-[50px] rounded-br-[50px] flex items-center justify-center"
    >
        <h2
            class="text-primary-white font-cormorant font-light text-[3.2rem] sm:text-[4rem] md:text-[8rem] tracking-[-6.5%] leading-none col-span-2"
        >
            <span
                class="font-cormorant font-bold italic text-[4rem] sm:text-[10rem] md:text-[10rem] tracking-[-8%]"
                >P</span
            >rojects
        </h2>
    </div>
</div>
